PORT=3333
DB_HOST=localhost
DB_PORT=5432
DB_USER=postec_user
DB_PASSWORD=postec_password
DB_NAME=postec_db
# Opcional: DATABASE_URL substitui os campos DB_*.
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
APP_PUBLIC_URL=http://localhost:5173
NUVEMSHOP_APP_ID=46963
NUVEMSHOP_CLIENT_SECRET=
# Identificação exigida em cada chamada: nome e um contato real.
NUVEMSHOP_USER_AGENT=
# Gere uma vez: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Preserve a chave para conseguir ler os tokens já armazenados.
INTEGRATION_ENCRYPTION_KEY=

# Produção Supabase: URI do Session pooler (porta 5432) com sslmode=verify-full.
# Session mode é necessário para os advisory locks usados pelo worker.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Opcional: conexão direta ou Session pooler para migrações; nunca Transaction pooler.
DIRECT_URL=
DB_POOL_MAX=3
# Segredo aleatório para /api/internal/nuvemshop-worker (agendador).
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# CA PEM do Supabase; permite \n entre linhas. Validação TLS permanece obrigatória.
DATABASE_SSL_CA=
