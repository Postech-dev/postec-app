{
  "name": "postec-app",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "db:migrate": "npm run migrate --workspace backend",
    "db:init": "npm run migrate --workspace backend -- --init"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/functions": "^3.0.0"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
